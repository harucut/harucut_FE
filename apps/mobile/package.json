{
  "name": "harucut-mobile",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "scripts": {
    "start": "expo start",
    "dev-client": "expo start --dev-client",
    "android": "expo start --android",
    "android:dev": "expo run:android",
    "lint": "expo lint",
    "typecheck": "tsc --noEmit",
    "export:release": "EXPO_NO_DOTENV=1 EXPO_NO_TELEMETRY=1 expo export --platform ios --platform android --output-dir dist-release",
    "prebuild:release": "EXPO_NO_DOTENV=1 EXPO_NO_TELEMETRY=1 expo prebuild --no-install"
  },
  "dependencies": {
    "@expo/dom-webview": "~57.0.1",
    "@expo/metro-runtime": "~57.0.16",
    "@harucut/shared": "workspace:*",
    "expo": "~57.0.0",
    "expo-constants": "~57.0.20",
    "expo-dev-client": "~57.0.19",
    "expo-file-system": "~57.0.7",
    "expo-haptics": "~57.0.3",
    "expo-linking": "~57.0.11",
    "expo-media-library": "^57.0.5",
    "expo-notifications": "~57.0.21",
    "expo-router": "~57.0.24",
    "expo-splash-screen": "~57.0.9",
    "expo-status-bar": "~57.0.1",
    "expo-system-ui": "~57.0.4",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.86.3",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.2",
    "react-native-webview": "^13.16.1",
    "react-native-worklets": "0.10.1"
  },
  "devDependencies": {
    "@react-native/metro-config": "0.86.3",
    "@types/node": "^26.4.0",
    "@types/react": "~19.3.0",
    "eslint": "^9.39.5",
    "eslint-config-expo": "~57.0.2",
    "typescript": "~6.0.3"
  },
  "private": true
}
