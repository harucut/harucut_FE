{
  "expo": {
    "name": "Harucut",
    "slug": "harucut-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "harucut",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "android": {
      "package": "com.harucut.app",
      "adaptiveIcon": {
        "backgroundColor": "#0B0B0C",
        "foregroundImage": "./assets/images/android-icon-foreground.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "ios": {
      "bundleIdentifier": "com.harucut.app",
      "supportsTablet": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-camera",
        {
          "cameraPermission": "네컷 사진을 찍을 때 카메라를 사용해요.",
          "recordAudioAndroid": false,
          "microphonePermission": false
        }
      ],
      [
        "expo-media-library",
        {
          "savePhotosPermission": "촬영한 네컷을 사진첩에 저장할 때 사용해요.",
          "photosPermission": "촬영한 네컷을 사진첩에 저장할 때 사용해요.",
          "isAccessMediaLocationEnabled": false
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#0B0B0C",
          "dark": {
            "backgroundColor": "#0B0B0C"
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "apiBaseUrl": "https://api.harucut.com",
      "router": {},
      "eas": {
        "projectId": "1ccc6938-4a60-45f0-8a06-4db1a0101b0f"
      }
    }
  }
}
