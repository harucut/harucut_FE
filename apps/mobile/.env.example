# 앱이 띄울 웹 주소.
#
# 앱은 자기 화면을 그리지 않고 이 웹을 그대로 띄운다(components/harucut-web-shell.tsx).
# 값을 비우면 app.json 의 extra.webOrigin(운영 주소)이 쓰인다.
#
# 안드로이드 에뮬레이터에서 호스트의 localhost 는 10.0.2.2 다 — localhost 로 두면
# 에뮬레이터 자기 자신을 가리켜 아무것도 안 뜬다. 실기기(USB)는 PC 의 LAN IP 로 바꿀 것.
EXPO_PUBLIC_WEB_ORIGIN=http://10.0.2.2:3000

# 배포 웹을 볼 때
# EXPO_PUBLIC_WEB_ORIGIN=https://www.harucut.com
