{
  "cli": {
    "version": ">= 16.0.0",
    "appVersionSource": "local"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal"
    },
    "preview": {
      "distribution": "internal",
      "env": { "EXPO_NO_DOTENV": "1" }
    },
    "production": {
      "autoIncrement": true,
      "env": { "EXPO_NO_DOTENV": "1" }
    }
  },
  "submit": {
    "production": {}
  }
}
