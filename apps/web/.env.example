# Local backend
NEXT_PUBLIC_BASE_URL=http://localhost:8080

# Or use the deployed API when local backend is unavailable
# NEXT_PUBLIC_BASE_URL=https://api.harucut.com

# 로컬 개발 전용: 로그인 없이 보호 경로(/home, /shoot, /upload, /decorate, /history, /theme, /mypage)에
# 들어갈 수 있게 한다. 값이 정확히 1일 때만 켜지고, 프로덕션 빌드에서는 항상 무시된다.
# (lib/devAuthBypass.test.ts 가 프로덕션에서 꺼짐을 단언한다.)
# playwright는 webServer.env로 0을 고정하므로 e2e는 이 값과 무관하게 돈다.
# NEXT_PUBLIC_DEV_AUTH_BYPASS=1

# BFF → 백엔드 공유 비밀(서버 전용, NEXT_PUBLIC_ 금지). 백엔드 BFF_SHARED_SECRET 과 같아야 한다.
# 비어 있으면 백엔드는 BFF 출구 IP 로 빈도를 제한한다 — 행사 참가자 전체가 한 IP 로 묶인다.
# BFF_SHARED_SECRET=
