{
  "name": "harucut-web",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.22.0",
  "scripts": {
    "generate:stickers": "node scripts/generate-stickers.mjs",
    "dev": "next dev",
    "build": "pnpm generate:stickers && next build --webpack",
    "start": "next start",
    "lint": "eslint .",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:install": "playwright install --with-deps",
    "test:a11y": "playwright test tests/e2e/accessibility.spec.ts",
    "test:visual": "playwright test -c playwright.visual.config.ts",
    "test:visual:update": "playwright test -c playwright.visual.config.ts --update-snapshots",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build"
  },
  "dependencies": {
    "@harucut/shared": "workspace:*",
    "@imgly/background-removal": "1.7.0",
    "axios": "^1.16.0",
    "jose": "^6.2.3",
    "konva": "^10.3.0",
    "lucide-react": "^1.14.0",
    "next": "16.2.6",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "react-konva": "^19.2.1",
    "use-image": "^1.1.4",
    "webm-muxer": "^5.1.4",
    "zustand": "^5.0.13"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.11.3",
    "@playwright/test": "^1.60.0",
    "@storybook/nextjs-vite": "10.3.6",
    "@storybook/react": "10.3.6",
    "@tailwindcss/postcss": "^4.3.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/jest": "^30.0.0",
    "@types/jest-axe": "^3.5.9",
    "@types/node": "^20",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19",
    "esbuild": "0.28.0",
    "eslint": "^9",
    "eslint-config-next": "16.2.9",
    "jest": "^30.4.2",
    "jest-axe": "^10.0.0",
    "jest-environment-jsdom": "^30.4.1",
    "msw": "^1.3.5",
    "playwright": "^1.60.0",
    "storybook": "^10.3.6",
    "tailwindcss": "^4.3.0",
    "ts-jest": "^29.4.11",
    "typescript": "^5"
  }
}
